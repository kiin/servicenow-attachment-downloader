# Copy to .env and place it next to the .exe (never commit the real .env)
SN_INSTANCE=https://yourinstance.service-now.com
SN_USERNAME=your.user
# Leave SN_PASSWORD out to be prompted for it when the tool runs
SN_PASSWORD=

DOWNLOAD_DIR=~/Downloads/ServiceNowAttachments

# Encoded query on sys_attachment, e.g. table_name=incident^sys_created_on>=javascript:gs.daysAgoStart(7)
QUERY=table_name=incident

# Page size per request, and optional overall cap (0 = everything)
LIMIT=100
MAX_RECORDS=0
